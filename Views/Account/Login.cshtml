@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Round-OP</title>
    <link rel="stylesheet" href="~/css/site.css"/>
    <link rel="icon" type="image/x-icon" href="~/favicon.png" />
</head>

<body class="min-h-screen bg-amber-100 text-amber-950">
    <partial name="_Toast" />
    <div class="flex min-h-[calc(100vh-80px)] items-center justify-center bg-amber-100 px-6 py-16">
        <div class="w-full max-w-md">

            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-8 shadow-xl shadow-amber-950/5 sm:p-10">

                <!-- Logo -->
                <div class="mb-3 flex justify-center">
                    <img src="~/images/logo.png"
                         alt="Round-OP"
                         class="h-16 w-16 object-contain" />
                </div>

                <div class="text-center">
                    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-700">
                        Round-OP
                    </p>

                    <h1 class="mt-1 text-3xl font-bold tracking-tight text-amber-950">
                        Admin Login
                    </h1>

                    <p class="mt-2 text-sm leading-6 text-amber-950/60">
                        Sign in to access the investigation reporting administration portal.
                    </p>
                </div>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      class="mt-4 space-y-5">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email"
                               class="mb-2 block text-sm font-semibold text-amber-950">
                            Email Address
                        </label>

                        <input type="email"
                               id="email"
                               name="email"
                               autocomplete="email"
                               required
                               class="block w-full rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm text-amber-950 outline-none transition placeholder:text-amber-950/30 focus:border-amber-600 focus:ring-4 focus:ring-amber-500/10"
                               placeholder="admin@example.com" />
                    </div>

                    <!-- Password -->
                    <div>
                        <label for="password"
                               class="mb-2 block text-sm font-semibold text-amber-950">
                            Password
                        </label>

                        <input type="password"
                               id="password"
                               name="password"
                               autocomplete="current-password"
                               required
                               class="block w-full rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm text-amber-950 outline-none transition placeholder:text-amber-950/30 focus:border-amber-600 focus:ring-4 focus:ring-amber-500/10"
                               placeholder="Enter your password" />
                    </div>

                    <!-- Remember -->
                    <label class="flex items-center gap-3 text-sm text-amber-950/70">
                        <input type="checkbox"
                               name="rememberMe"
                               value="true"
                               class="h-4 w-4 rounded border-amber-300 text-amber-800 focus:ring-amber-500" />

                        <span>Remember me</span>
                    </label>

                    <!-- Submit -->
                    <button type="submit"
                            class="w-full rounded-lg bg-amber-900 px-5 py-3.5 text-sm font-semibold text-amber-50 shadow-sm transition hover:bg-amber-800 focus:outline-none focus:ring-4 focus:ring-amber-900/20">
                        Sign In
                    </button>

                </form>

            </div>

            <p class="mt-6 text-center text-xs text-amber-950/50">
                Authorized personnel only.
            </p>

        </div>
    </div>

</body>
