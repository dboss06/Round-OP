@model Round_OP.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<div class="space-y-8">

    <!-- Header -->
    <div>
        <p class="text-sm font-medium text-amber-700">
            Administration
        </p>

        <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            Dashboard
        </h1>

        <p class="mt-2 text-sm text-slate-500">
            Overview of investigation reports submitted to the system.
        </p>
    </div>


    <!-- Stats -->
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">

        <!-- Total -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Total Reports
            </p>

            <p class="mt-3 text-3xl font-bold text-slate-900">
                @Model.TotalReports
            </p>
        </div>

        <!-- Open -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Open
            </p>

            <p class="mt-3 text-3xl font-bold text-blue-700">
                @Model.OpenReports
            </p>
        </div>

        <!-- Pending -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Pending
            </p>

            <p class="mt-3 text-3xl font-bold text-amber-700">
                @Model.PendingReports
            </p>
        </div>

        <!-- Under Review -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Under Review
            </p>

            <p class="mt-3 text-3xl font-bold text-purple-700">
                @Model.UnderReviewReports
            </p>
        </div>

        <!-- Closed -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Closed
            </p>

            <p class="mt-3 text-3xl font-bold text-green-700">
                @Model.ClosedReports
            </p>
        </div>

    </div>


    <!-- Recent Reports -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

        <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">

            <div>
                <h2 class="text-lg font-semibold text-slate-900">
                    Recent Reports
                </h2>

                <p class="mt-1 text-sm text-slate-500">
                    The five most recently submitted investigation reports.
                </p>
            </div>

            @if (Model.RecentReports.Any())
            {
                <a asp-controller="Admin"
                   asp-action="Reports"
                   class="text-sm font-semibold text-amber-800 transition hover:text-amber-900">
                    View all reports →
                </a>
            }

        </div>


        @if (Model.RecentReports.Any())
        {
            <div class="overflow-x-auto">

                <table class="min-w-full divide-y divide-slate-200">

                    <thead class="bg-slate-50">
                        <tr>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Report
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Investigator
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Status
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Priority
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Submitted
                            </th>

                            <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Action
                            </th>

                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">

                        @foreach (var report in Model.RecentReports)
                        {
                            <tr class="transition hover:bg-amber-50/40">

                                <td class="whitespace-nowrap px-6 py-4">
                                    <p class="text-sm font-semibold text-slate-900">
                                        @report.ReportId
                                    </p>

                                    <p class="mt-1 text-xs text-slate-500">
                                        @report.ComplaintType.GetDisplayName()
                                    </p>
                                </td>

                                <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-700">
                                    @report.InvestigatorName
                                </td>

                                <td class="whitespace-nowrap px-6 py-4">
                                    <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900">
                                        @report.CaseStatus.GetDisplayName()
                                    </span>
                                </td>

                                <td class="whitespace-nowrap px-6 py-4">
                                    <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                                        @report.InvestigationPriority.GetDisplayName()
                                    </span>
                                </td>

                                <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600">
                                    @report.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </td>

                                <td class="whitespace-nowrap px-6 py-4 text-right">
                                    <a asp-controller="Admin"
                                       asp-action="ReportDetails"
                                       asp-route-id="@report.Id"
                                       class="text-sm font-semibold text-amber-800 transition hover:text-amber-950">
                                        View
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="px-6 py-20 text-center">

                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 text-amber-800">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="h-8 w-8"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor"
                         stroke-width="1.7">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M7 3h7l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M14 3v5h5M9 13h6M9 17h4" />
                    </svg>

                </div>

                <h3 class="mt-5 text-lg font-semibold text-slate-900">
                    No investigation reports yet
                </h3>

                <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
                    Once an investigation report is submitted, it will appear here
                    for administrative review.
                </p>

                <a asp-controller="Reports"
                   asp-action="Create"
                   class="mt-6 inline-flex rounded-lg bg-amber-900 px-5 py-2.5 text-sm font-semibold text-amber-50 transition hover:bg-amber-800">
                    Submit a Report
                </a>

            </div>
        }

    </section>

</div>