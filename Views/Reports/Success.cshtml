@{
    ViewData["Title"] = "Report Submitted";
    Layout = "_Layout";

    var reportId = ViewData["ReportId"]?.ToString();
}

<section class="flex min-h-[calc(100vh-80px)] items-center justify-center bg-amber-100 px-6 py-16">
    <div class="w-full max-w-xl text-center">

        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-amber-900 text-amber-50">
            <svg xmlns="http://www.w3.org/2000/svg"
                 class="h-7 w-7"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m5 12 4 4L19 6" />
            </svg>
        </div>

        <h1 class="mt-6 text-4xl font-bold tracking-tight text-amber-950">
            Report Submitted
        </h1>

        <p class="mt-4 leading-7 text-amber-950/70">
            Your investigation report has been successfully submitted.
        </p>

        @if (!string.IsNullOrWhiteSpace(reportId))
        {
            <div class="mx-auto mt-8 max-w-sm rounded-xl border border-amber-200 bg-amber-50 p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">
                    Report Reference
                </p>

                <p class="mt-2 text-xl font-bold tracking-wide text-amber-950">
                    @reportId
                </p>
            </div>
        }

        <a asp-controller="Home"
           asp-action="Index"
           class="mt-8 inline-flex rounded-lg bg-amber-900 px-6 py-3 text-sm font-semibold text-amber-50 transition hover:bg-amber-800">
            Return Home
        </a>

    </div>
</section>
