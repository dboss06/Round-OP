@model Round_OP.ViewModels.InvestigationReportViewModel

@{
    ViewData["Title"] = "Investigation Report";
    Layout = "_Layout";
}

<div class="min-h-screen bg-amber-100">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="mb-8">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-700">
                Round-OP Mayor Office
            </p>

            <h1 class="mt-2 text-3xl font-bold tracking-tight text-amber-950 sm:text-4xl">
                Investigation Report
            </h1>

            <p class="mt-3 max-w-3xl text-sm leading-6 text-amber-950/65 sm:text-base">
                Complete each section of the investigation report in order.
                You must complete the current section before proceeding.
            </p>
        </div>

        <!-- Progress -->
        <div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p id="stepNumber" class="text-sm font-semibold text-amber-900">
                        Step 1 of 8
                    </p>

                    <p id="stepTitle" class="mt-1 text-sm text-amber-900/60">
                        Investigator Information
                    </p>
                </div>

                <span id="progressPercent" class="text-sm font-semibold text-amber-700">
                    20%
                </span>
            </div>

            <div class="mt-4 h-2 overflow-hidden rounded-full bg-amber-200">
                <div id="progressBar" class="h-full rounded-full bg-amber-800 transition-all duration-300"
                     style="width: 20%">
                </div>
            </div>
        </div>

        <!-- Section Navigation -->
        <div
            class="sticky top-0 z-30 mb-6 overflow-x-auto rounded-2xl border border-amber-200 bg-amber-50/95 p-2 shadow-sm backdrop-blur">
            <nav class="flex min-w-max gap-2" id="sectionNavigation">

                <button type="button" data-step="0" class="section-nav active">
                    <span class="step-indicator">1</span>
                    <span>Investigator</span>
                </button>

                <button type="button" data-step="1" class="section-nav locked">
                    <span class="step-indicator">2</span>
                    <span>Case</span>
                </button>

                <button type="button" data-step="2" class="section-nav locked">
                    <span class="step-indicator">3</span>
                    <span>Investigation</span>
                </button>

                <button type="button" data-step="3" class="section-nav locked">
                    <span class="step-indicator">4</span>
                    <span>Blockchain</span>
                </button>

                <button type="button" data-step="4" class="section-nav locked">
                    <span class="step-indicator">5</span>
                    <span>Findings</span>
                </button>

                <button type="button" data-step="5" class="section-nav locked">
                    <span class="step-indicator">6</span>
                    <span>Wallet Registration</span>
                </button>

                <button type="button" data-step="6" class="section-nav locked">
                    <span class="step-indicator">7</span>
                    <span>Financial Flow</span>
                </button>

                <button type="button" data-step="7" class="section-nav locked">
                    <span class="step-indicator">8</span>
                    <span>Court Proceedings</span>
                </button>
            </nav>
        </div>

        <!-- Report Form -->
        <form asp-controller="@(ViewData["IsUserEdit"] is true ? "User" : "Reports")"
              asp-action="@(ViewData["IsUserEdit"] is true ? "Update" : "Create")" method="post"
              enctype="multipart/form-data" id="investigationForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            </div>

            <!-- ================================================= -->
            <!-- SECTION 1 -->
            <!-- ================================================= -->

            <section class="form-section" data-section="0" id="investigator-section">

                <div class="rounded-2xl border border-amber-200 bg-amber-50 shadow-sm">

                    <div class="border-b border-amber-200 px-6 py-6 sm:px-8">
                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">
                            Section 1
                        </p>

                        <h2 class="mt-2 text-2xl font-bold text-amber-950">
                            Investigator Information
                        </h2>

                        <p class="mt-2 text-sm text-amber-950/60">
                            Enter the information identifying the investigator and reporting unit.
                        </p>
                    </div>

                    <div class="p-6 sm:p-8">

                        <div class="grid gap-6 md:grid-cols-2">

                            <!-- Investigator Name -->
                            <div>
                                <label asp-for="InvestigatorName"
                                       class="mb-2 block text-sm font-semibold text-amber-950">
                                    Investigator Name
                                    <span class="text-red-600">*</span>
                                </label>

                                <input asp-for="InvestigatorName" type="text" autocomplete="name" required
                                       class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm text-amber-950 outline-none transition placeholder:text-amber-950/30 focus:border-amber-700 focus:ring-4 focus:ring-amber-500/10"
                                       placeholder="Enter investigator name" />

                                <span asp-validation-for="InvestigatorName" class="mt-1 block text-xs text-red-600">
                                </span>
                            </div>

                            <!-- Badge / ID -->
                            <div>
                                <label asp-for="BadgeIdNumber" class="mb-2 block text-sm font-semibold text-amber-950">
                                    Badge / ID Number
                                    <span class="text-red-600">*</span>
                                </label>

                                <input asp-for="BadgeIdNumber" type="text"
                                       class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm text-amber-950 outline-none transition placeholder:text-amber-950/30 focus:border-amber-700 focus:ring-4 focus:ring-amber-500/10"
                                       placeholder="Enter badge or ID number" required />

                                <span asp-validation-for="BadgeIdNumber" class="mt-1 block text-xs text-red-600">
                                </span>
                            </div>

                            <!-- Police Station / Unit -->
                            <div class="md:col-span-2">
                                <label asp-for="PoliceStationUnit"
                                       class="mb-2 block text-sm font-semibold text-amber-950">
                                    Police Station / Unit
                                    <span class="text-red-600">*</span>
                                </label>

                                <input asp-for="PoliceStationUnit" type="text"
                                       class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm text-amber-950 outline-none transition placeholder:text-amber-950/30 focus:border-amber-700 focus:ring-4 focus:ring-amber-500/10"
                                       placeholder="Enter police station or unit" required />

                                <span asp-validation-for="PoliceStationUnit" class="mt-1 block text-xs text-red-600">
                                </span>
                            </div>

                            <!-- Date -->
                            <div>
                                <label asp-for="DateOfReport" class="mb-2 block text-sm font-semibold text-amber-950">
                                    Date of Report
                                    <span class="text-red-600">*</span>
                                </label>

                                <input asp-for="DateOfReport" type="date"
                                       class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm text-amber-950 outline-none transition focus:border-amber-700 focus:ring-4 focus:ring-amber-500/10"
                                       placeholder="Select date of report" required />

                                <span asp-validation-for="DateOfReport" class="mt-1 block text-xs text-red-600">
                                </span>
                            </div>

                        </div>

                    </div>
                </div>

                <div class="mt-6 flex justify-end">
                    <button type="button"
                            class="next-button rounded-lg bg-amber-900 px-6 py-3 text-sm font-semibold text-amber-50 transition hover:bg-amber-800 disabled:cursor-not-allowed disabled:opacity-50">
                        Next: Case Information
                    </button>
                </div>

            </section>


            <!-- ================================================= -->
            <!-- SECTION 2 -->
            <!-- ================================================= -->

            <section class="form-section hidden" data-section="1" id="case-section">

                <div class="rounded-2xl border border-amber-200 bg-amber-50 shadow-sm">

                    <div class="border-b border-amber-200 px-6 py-6 sm:px-8">
                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">
                            Section 2
                        </p>

                        <h2 class="mt-2 text-2xl font-bold text-amber-950">
                            Case Information
                        </h2>

                        <p class="mt-2 text-sm text-amber-950/60">
                            Provide the identifying and classification details for the investigation.
                        </p>
                    </div>

                    <div class="space-y-8 p-6 sm:p-8">

                        <!-- Case Number / Report Number -->
                        <div class="grid gap-6 md:grid-cols-2">

                            <div>
                                <label asp-for="CaseNumber" class="mb-2 block text-sm font-semibold text-amber-950">
                                    Case Number
                                </label>

                                <input asp-for="CaseNumber" type="text"
                                       class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm text-amber-950 outline-none transition placeholder:text-amber-950/30 focus:border-amber-700 focus:ring-4 focus:ring-amber-500/10"
                                       placeholder="Enter case number" />

                                <span asp-validation-for="CaseNumber" class="mt-1 block text-xs text-red-600">
                                </span>
                            </div>

                            <div>
                                <label asp-for="ReportNumber" class="mb-2 block text-sm font-semibold text-amber-950">
                                    Report Number
                                </label>

                                <input asp-for="ReportNumber" type="text"
                                       class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm text-amber-950 outline-none transition placeholder:text-amber-950/30 focus:border-amber-700 focus:ring-4 focus:ring-amber-500/10"
                                       placeholder="Enter report number" />

                                <span asp-validation-for="ReportNumber" class="mt-1 block text-xs text-red-600">
                                </span>
                            </div>

                        </div>

                        <!-- Case Status -->
                        <div>
                            <div class="mb-3">
                                <p class="text-sm font-semibold text-amber-950">
                                    Case Status
                                    <span class="text-red-600">*</span>
                                </p>

                                <p class="mt-1 text-xs text-amber-950/55">
                                    Select the current status of the case.
                                </p>
                            </div>

                            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">

                                @foreach (var status in Enum.GetValues<Round_OP.Models.Enums.CaseStatus>())
                                {
                                    var id = $"case-status-{status}";

                                    <label for="@id"
                                           class="group flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">

                                        <input id="@id" asp-for="CaseStatus" type="radio" value="@status"
                                               class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                        <span class="text-sm font-medium text-amber-950">
                                            @status
                                        </span>

                                    </label>
                                }

                            </div>

                            <span asp-validation-for="CaseStatus" class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Investigation Priority -->
                        <div>
                            <div class="mb-3">
                                <p class="text-sm font-semibold text-amber-950">
                                    Investigation Priority
                                    <span class="text-red-600">*</span>
                                </p>

                                <p class="mt-1 text-xs text-amber-950/55">
                                    Select the urgency level for this investigation.
                                </p>
                            </div>

                            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">

                                @foreach (var priority in Enum.GetValues<Round_OP.Models.Enums.InvestigationPriority>())
                                {
                                    var id = $"priority-{priority}";

                                    <label for="@id"
                                           class="group flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">

                                        <input id="@id" asp-for="InvestigationPriority" type="radio" value="@priority"
                                               class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                        <span class="text-sm font-medium text-amber-950">
                                            @priority
                                        </span>

                                    </label>
                                }

                            </div>

                            <span asp-validation-for="InvestigationPriority" class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Complaint Type -->
                        <div>
                            <div class="mb-3">
                                <p class="text-sm font-semibold text-amber-950">
                                    Complaint Type
                                    <span class="text-red-600">*</span>
                                </p>

                                <p class="mt-1 text-xs text-amber-950/55">
                                    Select the primary type of complaint being investigated.
                                </p>
                            </div>

                            <div class="grid gap-3 md:grid-cols-2">

                                @foreach (var complaint in Enum.GetValues<Round_OP.Models.Enums.ComplaintType>())
                                {
                                    var id = $"complaint-{complaint}";

                                    <label for="@id"
                                           class="group flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">

                                        <input id="@id" asp-for="ComplaintType" type="radio" value="@complaint"
                                               class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                        <span class="text-sm font-medium text-amber-950">
                                            @{
                                                var label = complaint switch
                                                {
                                                    Round_OP.Models.Enums.ComplaintType.CryptocurrencyFraud
                                                        => "Cryptocurrency Fraud",

                                                    Round_OP.Models.Enums.ComplaintType.InvestmentScam
                                                        => "Investment Scam",

                                                    Round_OP.Models.Enums.ComplaintType.IdentityTheft
                                                        => "Identity Theft",

                                                    Round_OP.Models.Enums.ComplaintType.MoneyLaundering
                                                        => "Money Laundering",

                                                    _ => complaint.ToString()
                                                };
                                            }

                                            @label
                                        </span>

                                    </label>
                                }

                            </div>

                            <span asp-validation-for="ComplaintType" class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                    </div>
                </div>

                <div class="mt-6 flex items-center justify-between">
                    <button type="button"
                            class="previous-button rounded-lg border border-amber-300 bg-amber-50 px-6 py-3 text-sm font-semibold text-amber-900 transition hover:bg-amber-100">
                        Previous
                    </button>

                    <button type="button"
                            class="next-button rounded-lg bg-amber-900 px-6 py-3 text-sm font-semibold text-amber-50 transition hover:bg-amber-800">
                        Next: Investigation
                    </button>
                </div>

            </section>


            <!-- ================================================= -->
            <!-- SECTION 3 -->
            <!-- ================================================= -->

            <section class="form-section hidden" data-section="2" id="investigation-actions-section">

                <div class="rounded-2xl border border-amber-200 bg-amber-50 shadow-sm">

                    <div class="border-b border-amber-200 px-6 py-6 sm:px-8">
                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">
                            Section 3
                        </p>

                        <h2 class="mt-2 text-2xl font-bold text-amber-950">
                            Investigation Actions
                        </h2>

                        <p class="mt-2 text-sm text-amber-950/60">
                            Record the investigative actions and evidence-handling activities completed.
                        </p>
                    </div>

                    <div class="space-y-8 p-6 sm:p-8">

                        <!-- Initial Complaint Received -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Initial Complaint Received
                                <span class="text-red-600">*</span>
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="InitialComplaintReceived" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="InitialComplaintReceived" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>

                            <span asp-validation-for="InitialComplaintReceived" class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Evidence Received -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Evidence Received
                                <span class="text-red-600">*</span>
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="EvidenceReceived" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="EvidenceReceived" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>

                            <span asp-validation-for="EvidenceReceived" class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Evidence Verified -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Evidence Verified
                                <span class="text-red-600">*</span>
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="EvidenceVerified" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="EvidenceVerified" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>

                            <span asp-validation-for="EvidenceVerified" class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Witness Interview Date -->
                        <div class="max-w-md">
                            <label asp-for="WitnessInterviewDate"
                                   class="mb-2 block text-sm font-semibold text-amber-950">
                                Witness Interview Date
                            </label>

                            <input asp-for="WitnessInterviewDate" type="date"
                                   class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm text-amber-950 outline-none transition focus:border-amber-700 focus:ring-4 focus:ring-amber-500/10" />

                            <span asp-validation-for="WitnessInterviewDate" class="mt-1 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Blockchain Analysis Requested -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Blockchain Analysis Requested
                                <span class="text-red-600">*</span>
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="BlockchainAnalysisRequested" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="BlockchainAnalysisRequested" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>

                            <span asp-validation-for="BlockchainAnalysisRequested"
                                  class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Blockchain Analysis Approved -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Blockchain Analysis Approved
                                <span class="text-red-600">*</span>
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="BlockchainAnalysisApproved" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="BlockchainAnalysisApproved" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>

                            <span asp-validation-for="BlockchainAnalysisApproved"
                                  class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Transaction History Obtained -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Transaction History Obtained
                                <span class="text-red-600">*</span>
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="TransactionHistoryObtained" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="TransactionHistoryObtained" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>

                            <span asp-validation-for="TransactionHistoryObtained"
                                  class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Wallet Tracing Completed -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Wallet Tracing Completed
                                <span class="text-red-600">*</span>
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="WalletTracingCompleted" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
