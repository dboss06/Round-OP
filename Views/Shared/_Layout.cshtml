<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Round-OP</title>
    <link rel="stylesheet" href="~/css/site.css"/>
    <link rel="icon" type="image/x-icon" href="~/favicon.png" />
</head>

<body class="min-h-screen bg-amber-100 text-amber-950">
    <partial name="_Toast" />
    <nav class="w-full bg-amber-100">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-8">
            <a href="/" class="flex items-center gap-2">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg text-white">
                    <img src="~/images/logo.png" alt="Round-Op Alpha Mayor Office" class="h-12 w-12 object-contain">
                </div>

                <span class="text-lg font-semibold tracking-tight text-amber-950">
                    Round-<span class="text-amber-700">OP</span> Alpha
                </span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex items-center gap-4">
                    <span class="text-sm font-medium text-amber-950">
                        Welcome, @User.Identity.Name
                    </span>

                    @if (!User.IsInRole("Admin"))
                    {
                        <a asp-controller="User" asp-action="Index"
                           class="rounded-lg bg-amber-900 px-4 py-2 text-sm font-semibold text-amber-50 hover:bg-amber-800">
                            My Report
                        </a>
                    }

                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="text-sm font-semibold text-amber-900 hover:text-amber-700">
                            Logout
                        </button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="border-t border-amber-200 bg-amber-100">
        <div class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-3">
                    <img src="/images/logo.png" alt="Round-OP" class="h-10 w-10 object-contain">
                    <div>
                        <p class="font-semibold text-amber-950">Round-OP</p>
                        <p class="text-xs text-amber-900/60">Investigative Report portal</p>
                    </div>
                </div>
                <div class="flex items-center gap-6 text-sm text-amber-900/70">
                    <a href="#" class="transition hover:text-amber-950">Privacy</a>
                    <a href="#" class="transition hover:text-amber-950">Terms</a>
                    <a asp-action="Create" asp-controller="Reports"
                       class="font-semibold text-amber-800 transition hover:text-amber-950">
                        Submit
                        Report
                    </a>
                </div>
            </div>
            <div class="mt-8 border-t border-amber-200 pt-6">
                <p class="text-xs text-amber-900/50">&copy; 2026 Round-OP Mayor Office. All Rights Reserved</p>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>