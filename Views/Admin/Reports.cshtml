@model Round_OP.ViewModels.ReportsViewModel;
@{
    ViewData["Title"] = "Reports"; 
    Layout = "_AdminLayout"; 
}
<div class="space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">

        <div>
            <p class="text-sm font-medium text-amber-700">
                Investigation Management
            </p>

            <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                Investigation Reports
            </h1>

            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
                Review submitted investigation reports and access their complete records.
            </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                Total Reports
            </p>

            <p class="mt-1 text-2xl font-bold text-slate-900">
                @Model.Reports.Count
            </p>
        </div>

    </div>


    <!-- Filters -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

        <form asp-controller="Admin"
              asp-action="Reports"
              method="get"
              class="space-y-5">

            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">

                <!-- Search -->
                <div class="lg:col-span-1">
                    <label asp-for="Search"
                           class="mb-2 block text-sm font-semibold text-slate-800">
                        Search
                    </label>

                    <div class="relative">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="2">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>

                        <input asp-for="Search"
                               placeholder="Report ID, case number, investigator..."
                               class="w-full rounded-lg border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-amber-700 focus:bg-white focus:ring-4 focus:ring-amber-500/10" />
                    </div>
                </div>

                <!-- Status -->
                <div>
                    <label asp-for="Status"
                           class="mb-2 block text-sm font-semibold text-slate-800">
                        Case Status
                    </label>

                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<Round_OP.Models.Enums.CaseStatus>()"
                            class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-amber-700 focus:bg-white focus:ring-4 focus:ring-amber-500/10">
                        <option value="">All statuses</option>
                    </select>
                </div>

                <!-- Priority -->
                <div>
                    <label asp-for="Priority"
                           class="mb-2 block text-sm font-semibold text-slate-800">
                        Priority
                    </label>

                    <select asp-for="Priority"
                            asp-items="Html.GetEnumSelectList<Round_OP.Models.Enums.InvestigationPriority>()"
                            class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-amber-700 focus:bg-white focus:ring-4 focus:ring-amber-500/10">
                        <option value="">All priorities</option>
                    </select>
                </div>

                <!-- Complaint Type -->
                <div>
                    <label asp-for="ComplaintType"
                           class="mb-2 block text-sm font-semibold text-slate-800">
                        Complaint Type
                    </label>

                    <select asp-for="ComplaintType"
                            asp-items="Html.GetEnumSelectList<Round_OP.Models.Enums.ComplaintType>()"
                            class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-amber-700 focus:bg-white focus:ring-4 focus:ring-amber-500/10">
                        <option value="">All complaint types</option>
                    </select>
                </div>

            </div>


            <!-- Filter Actions -->
            <div class="mt-1 flex flex-wrap items-center gap-3 border-slate-100 pt-2">

                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-lg bg-amber-900 px-5 py-2.5 text-sm font-semibold text-amber-50 transition hover:bg-amber-800">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="h-4 w-4"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor"
                         stroke-width="2">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M3 4h18M6 8h12M10 12h4M11 16h2M12 20v-4" />
                    </svg>

                    Apply Filters
                </button>

                <a asp-controller="Admin"
                   asp-action="Reports"
                   class="rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                    Clear Filters
                </a>

                @if (!string.IsNullOrWhiteSpace(Model.Search) ||
                     Model.Status.HasValue ||
                     Model.Priority.HasValue ||
                     Model.ComplaintType.HasValue)
                {
                    <span class="ml-auto text-sm text-slate-500">
                        Filtered results:
                        <span class="font-semibold text-slate-700">
                            @Model.Reports.Count
                        </span>
                    </span>
                }

            </div>

        </form>

    </section>


    <!-- Reports -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

        <!-- Table Header -->
        <div class="flex flex-col gap-2 border-b border-slate-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <div>
                <h2 class="font-semibold text-slate-900">
                    Submitted Reports
                </h2>

                <p class="mt-1 text-xs text-slate-500">
                    Most recently submitted reports appear first.
                </p>
            </div>

            <span class="text-sm text-slate-500">
                @Model.Reports.Count report@(Model.Reports.Count == 1 ? "" : "s")
            </span>
        </div>


        @if (Model.Reports.Any())
        {
            <div class="overflow-x-auto">

                <table class="min-w-full divide-y divide-slate-200">

                    <thead class="bg-slate-50">
                        <tr>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Report
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Investigator
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Case
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Status
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Priority
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Submitted
                            </th>

                            <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">
                                Action
                            </th>

                        </tr>
                    </thead>


                    <tbody class="divide-y divide-slate-100">

                        @foreach (var report in Model.Reports)
                        {
                            <tr class="transition hover:bg-amber-50/40">

                                <!-- Report -->
                                <td class="whitespace-nowrap px-6 py-5">
                                    <div class="flex items-center gap-3">

                                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-amber-800">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                 class="h-5 w-5"
                                                 fill="none"
                                                 viewBox="0 0 24 24"
                                                 stroke="currentColor"
                                                 stroke-width="1.8">
                                                <path stroke-linecap="round"
                                                      stroke-linejoin="round"
                                                      d="M7 3h7l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
                                                <path stroke-linecap="round"
                                                      stroke-linejoin="round"
                                                      d="M14 3v5h5M9 13h6M9 17h6" />
                                            </svg>
                                        </div>

                                        <div>
                                            <p class="text-sm font-semibold text-slate-900">
                                                @report.ReportId
                                            </p>

                                            <p class="mt-1 text-xs text-slate-500">
                                                @report.ComplaintType.GetDisplayName()
                                            </p>
                                        </div>

                                    </div>
                                </td>


                                <!-- Investigator -->
                                <td class="whitespace-nowrap px-6 py-5">
                                    <p class="text-sm font-medium text-slate-800">
                                        @report.InvestigatorName
                                    </p>
                                </td>


                                <!-- Case -->
                                <td class="whitespace-nowrap px-6 py-5">

                                    <p class="text-sm text-slate-800">
                                        @(string.IsNullOrWhiteSpace(report.CaseNumber)
                                            ? "No case number"
                                            : report.CaseNumber)
                                    </p>

                                    @if (!string.IsNullOrWhiteSpace(report.ReportNumber))
                                    {
                                        <p class="mt-1 text-xs text-slate-500">
                                            Report: @report.ReportNumber
                                        </p>
                                    }

                                </td>


                                <!-- Status -->
                                <td class="whitespace-nowrap px-6 py-5">

                                    @{
                                        var statusClass = report.CaseStatus switch
                                        {
                                            Round_OP.Models.Enums.CaseStatus.Open
                                                => "bg-blue-50 text-blue-700 ring-blue-600/10",

                                            Round_OP.Models.Enums.CaseStatus.Pending
                                                => "bg-amber-50 text-amber-700 ring-amber-600/10",

                                            Round_OP.Models.Enums.CaseStatus.UnderReview
                                                => "bg-purple-50 text-purple-700 ring-purple-600/10",

                                            Round_OP.Models.Enums.CaseStatus.Suspended
                                                => "bg-red-50 text-red-700 ring-red-600/10",

                                            Round_OP.Models.Enums.CaseStatus.Closed
                                                => "bg-green-50 text-green-700 ring-green-600/10",

                                            _ => "bg-slate-100 text-slate-700 ring-slate-500/10"
                                        };
                                    }

                                    <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset @statusClass">
                                        @report.CaseStatus.GetDisplayName()
                                    </span>

                                </td>


                                <!-- Priority -->
                                <td class="whitespace-nowrap px-6 py-5">

                                    @{
                                        var priorityClass = report.InvestigationPriority switch
                                        {
                                            Round_OP.Models.Enums.InvestigationPriority.Low
                                                => "bg-slate-100 text-slate-700",

                                            Round_OP.Models.Enums.InvestigationPriority.Medium
                                                => "bg-blue-50 text-blue-700",

                                            Round_OP.Models.Enums.InvestigationPriority.High
                                                => "bg-orange-50 text-orange-700",

                                            Round_OP.Models.Enums.InvestigationPriority.Critical
                                                => "bg-red-50 text-red-700",

                                            _ => "bg-slate-100 text-slate-700"
                                        };
                                    }

                                    <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold @priorityClass">
                                        @report.InvestigationPriority.GetDisplayName()
                                    </span>

                                </td>


                                <!-- Submitted -->
                                <td class="whitespace-nowrap px-6 py-5">

                                    <p class="text-sm text-slate-700">
                                        @report.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </p>

                                    <p class="mt-1 text-xs text-slate-400">
                                        @report.SubmittedAt.ToLocalTime().ToString("HH:mm")
                                    </p>

                                </td>


                                <!-- Action -->
                                <td class="whitespace-nowrap px-6 py-5 text-right">

                                    <a asp-controller="Admin"
                                       asp-action="ReportDetails"
                                       asp-route-id="@report.Id"
                                       class="inline-flex items-center gap-2 rounded-lg bg-amber-900 px-4 py-2.5 text-xs font-semibold text-amber-50 transition hover:bg-amber-800">

                                        View Report

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             class="h-3.5 w-3.5"
                                             fill="none"
                                             viewBox="0 0 24 24"
                                             stroke="currentColor"
                                             stroke-width="2">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="m9 5 7 7-7 7" />
                                        </svg>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        @if (!Model.Reports.Any())
        {
            var hasFilters =
                !string.IsNullOrWhiteSpace(Model.Search) ||
                Model.Status.HasValue ||
                Model.Priority.HasValue ||
                Model.ComplaintType.HasValue;

            <div class="px-6 py-20 text-center">

                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 text-amber-800">
                    @if (hasFilters)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="h-8 w-8"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.7">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="h-8 w-8"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.7">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M7 3h7l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M14 3v5h5M9 13h6M9 17h4" />
                        </svg>
                    }
                </div>

                @if (hasFilters)
                {
                    <h3 class="mt-5 text-lg font-semibold text-slate-900">
                        No matching reports
                    </h3>

                    <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
                        No investigation reports match your current search or filters.
                        Try adjusting your criteria.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Reports"
                       class="mt-6 inline-flex rounded-lg bg-amber-900 px-5 py-2.5 text-sm font-semibold text-amber-50 transition hover:bg-amber-800">
                        Clear Filters
                    </a>
                }
                else
                {
                    <h3 class="mt-5 text-lg font-semibold text-slate-900">
                        No investigation reports yet
                    </h3>

                    <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
                        Submitted investigation reports will appear here for administrative review.
                    </p>

                    <a asp-controller="Reports"
                       asp-action="Create"
                       class="mt-6 inline-flex rounded-lg bg-amber-900 px-5 py-2.5 text-sm font-semibold text-amber-50 transition hover:bg-amber-800">
                        Submit a Report
                    </a>
                }

            </div>
        }

    </section>

</div>
