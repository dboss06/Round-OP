@{
    ViewData["Title"] = "Something went wrong";
    Layout = "_Layout";
}

<div class="flex min-h-[calc(100vh-80px)] items-center justify-center bg-amber-100 px-6 py-16">
    <div class="w-full max-w-xl text-center">

        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100 text-red-700">
            <svg xmlns="http://www.w3.org/2000/svg"
                 class="h-8 w-8"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke="currentColor"
                 stroke-width="1.8">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
            </svg>
        </div>

        <p class="mt-6 text-sm font-semibold uppercase tracking-[0.2em] text-amber-700">
            Round-OP
        </p>

        <h1 class="mt-3 text-4xl font-bold tracking-tight text-amber-950">
            Something went wrong
        </h1>

        <p class="mx-auto mt-4 max-w-lg text-sm leading-7 text-amber-950/65 sm:text-base">
            We couldn't complete your request right now.
            Please try again in a moment.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a asp-controller="Home"
               asp-action="Index"
               class="rounded-lg bg-amber-900 px-6 py-3 text-sm font-semibold text-amber-50 transition hover:bg-amber-800">
                Return Home
            </a>

            <button type="button"
                    onclick="window.location.reload()"
                    class="rounded-lg border border-amber-300 bg-amber-50 px-6 py-3 text-sm font-semibold text-amber-900 transition hover:bg-amber-100">
                Try Again
            </button>
        </div>

    </div>
</div>