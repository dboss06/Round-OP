                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="SubmitToHeadquarters" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>
                        </div>

                        <!-- Close Case -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Close Case
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="CloseCase" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="CloseCase" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>
                        </div>

                        <!-- Report Reviewed -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Report Reviewed
                                <span class="text-red-600">*</span>
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="ReportReviewed" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="ReportReviewed" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>

                            <span asp-validation-for="ReportReviewed" class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Supervisor Approval -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Supervisor Approval
                                <span class="text-red-600">*</span>
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="SupervisorApproval" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="SupervisorApproval" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" required />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>

                            <span asp-validation-for="SupervisorApproval" class="mt-2 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Headquarters Submission -->
                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Headquarters Submission
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="HeadquartersSubmission" type="radio" value="Yes"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" />

                                    <span class="text-sm font-medium text-amber-950">
                                        Yes
                                    </span>
                                </label>

                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4 transition hover:border-amber-400 hover:bg-amber-50">
                                    <input asp-for="HeadquartersSubmission" type="radio" value="No"
                                           class="h-4 w-4 border-amber-300 text-amber-800 focus:ring-amber-500" />

                                    <span class="text-sm font-medium text-amber-950">
                                        No
                                    </span>
                                </label>

                            </div>
                        </div>

                        <!-- Case Closed Date -->
                        <div class="max-w-md">
                            <label asp-for="CaseClosedDate" class="mb-2 block text-sm font-semibold text-amber-950">
                                Case Closed
                            </label>

                            <input asp-for="CaseClosedDate" type="date"
                                   class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm text-amber-950 outline-none transition focus:border-amber-700 focus:ring-4 focus:ring-amber-500/10" />

                            <span asp-validation-for="CaseClosedDate" class="mt-1 block text-xs text-red-600">
                            </span>
                        </div>

                        <!-- Attachments -->
                        <!-- Attachments -->
                        <div>
                            <label asp-for="Attachments" class="mb-2 block text-sm font-semibold text-amber-950">
                                Attachments
                            </label>

                            <p class="mb-4 text-xs leading-5 text-amber-950/55">
                                Upload supporting documents, images, or other evidence relevant to the investigation.
                            </p>
                            @if (Model.ExistingAttachments.Any())
                            {
                                <div class="mb-6">
                                    <p class="mb-3 text-sm font-semibold text-amber-950">
                                        Previously Uploaded Attachments
                                    </p>

                                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                                        @foreach (var attachment in Model.ExistingAttachments)
                                        {
                                            var isImage = attachment.ContentType.StartsWith("image/");
                                            <div class="rounded-xl border border-amber-200 bg-white p-3">
                                                @if (isImage)
                                                {
                                                    <img src="@Url.Action("ViewAttachment", "Reports", new { attachmentId = attachment.Id })"
                                                         alt="@attachment.OriginalFileName"
                                                         class="mb-2 h-32 w-full rounded-lg object-cover" />
                                                }
                                                <p class="truncate text-xs text-amber-950/70">@attachment.OriginalFileName</p>
                                                <a href="@Url.Action("ViewAttachment", "Reports", new { attachmentId = attachment.Id })"
                                                   class="mt-1 inline-block text-xs font-medium text-amber-800 underline">
                                                    @(isImage ? "View full size" : "Download")
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            <!-- Upload Warning -->
                            <div class="mb-4 flex gap-3 rounded-xl border border-amber-300 bg-amber-50 p-4">
                                <div
                                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-amber-800">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M12 9v3m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
                                    </svg>
                                </div>

                                <div>
                                    <p class="text-sm font-semibold text-amber-950">
                                        File upload limit
                                    </p>

                                    <p class="mt-1 text-xs leading-5 text-amber-900/70">
                                        You can upload up to <span class="font-semibold">10 files</span>.
                                        Each file must be no larger than
                                        <span class="font-semibold">10 MB</span>,
                                        with a maximum total upload size of
                                        <span class="font-semibold">50 MB</span>.
                                    </p>
                                </div>
                            </div>

                            <label
                                class="flex min-h-40 cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-amber-300 bg-white px-6 py-8 text-center transition hover:border-amber-500 hover:bg-amber-50">

                                <svg xmlns="http://www.w3.org/2000/svg" class="h-9 w-9 text-amber-700" fill="none"
                                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M12 16V4m0 0-4 4m4-4 4 4M5 16.5v1.25A2.25 2.25 0 0 0 7.25 20h9.5A2.25 2.25 0 0 0 19 17.75V16.5" />
                                </svg>

                                <span class="mt-3 text-sm font-semibold text-amber-950">
                                    Select files to upload
                                </span>

                                <span class="mt-1 text-xs text-amber-950/50">
                                    Maximum 10 MB per file · Maximum 50 MB total
                                </span>

                                <input asp-for="Attachments" type="file" multiple class="hidden" />

                            </label>

                            <div id="selectedFiles" class="mt-3 space-y-2">
                            </div>

                            <span asp-validation-for="Attachments" class="mt-1 block text-xs text-red-600">
                            </span>

                            @if (ViewData.ModelState[nameof(Model.Attachments)]?.Errors.Any() == true)
                            {
                                <div class="mt-3 rounded-xl border border-red-200 bg-red-50 p-4">
                                    <ul class="space-y-1 text-sm text-red-700">
                                        @foreach (var error in ViewData.ModelState[nameof(Model.Attachments)]!.Errors)
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>

                        <!-- Final notice -->
                        <div class="rounded-xl border border-amber-200 bg-amber-100 p-5">
                            <p class="text-sm font-semibold text-amber-950">
                                Before submitting
                            </p>

                            <p class="mt-2 text-sm leading-6 text-amber-950/65">
                                Review the information in all five sections carefully.
                                The report will be submitted for administrative review once you select
                                <span class="font-semibold text-amber-900">Submit Investigation Report</span>.
                            </p>
                        </div>

                    </div>
                </div>

                <div class="mt-6 flex items-center justify-between">
                    <button type="button"
                            class="previous-button rounded-lg border border-amber-300 bg-amber-50 px-6 py-3 text-sm font-semibold text-amber-900 transition hover:bg-amber-100">
                        Previous
                    </button>

                    <button type="button" class="next-button rounded-lg bg-amber-900 px-6 py-3 text-sm font-semibold text-amber-50 transition hover:bg-amber-800">
                        Next: Wallet Registration Questions
                    </button>
                </div>

            </section>

            <!-- ================================================= -->
            <!-- SECTION 6 -->
            <!-- ================================================= -->

            <section class="form-section hidden"
                     data-section="5"
                     id="wallet-registration-section">

                <div class="rounded-2xl border border-amber-200 bg-amber-50 shadow-sm">

                    <div class="border-b border-amber-200 px-6 py-6 sm:px-8">

                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">
                            Section 6
                        </p>

                        <h2 class="mt-2 text-2xl font-bold text-amber-950">
                            Wallet Registration Questions
                        </h2>

                    </div>

                    <div class="space-y-8 p-6 sm:p-8">

                        <!-- Wallet Type -->

                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                What type of wallet are you registering?
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                @foreach (var option in new[]
                                {
                        "Bitcoin (BTC)",
                        "Ethereum (ETH)",
                        "USDT",
                        "Other"
                    })
                                {
                                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4">

                                        <input asp-for="WalletRegistrationType"
                                               type="radio"
                                               value="@option"
                                               class="h-4 w-4" />

                                        <span>@option</span>

                                    </label>
                                }

                            </div>
                        </div>


                        <!-- Wallet Purpose -->

                        <div>
                            <label asp-for="WalletPurpose"
                                   class="mb-2 block text-sm font-semibold text-amber-950">

                                What is the purpose of this wallet?

                            </label>

                            <select asp-for="WalletPurpose"
                                    class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3">

                                <option value="">Select purpose</option>
                                <option>Personal use</option>
                                <option>Business use</option>
                                <option>Investment</option>
                                <option>Transaction/payment</option>
                                <option>Recovery</option>
                                <option>Other</option>

                            </select>
                        </div>


                        <!-- Network -->

                        <div>

                            <label asp-for="WalletNetwork"
                                   class="mb-2 block text-sm font-semibold text-amber-950">

                                Which network will you use?

                            </label>

                            <select asp-for="WalletNetwork"
                                    class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3">

                                <option value="">Select network</option>
                                <option>Bitcoin Network</option>
                                <option>Ethereum (ERC-20)</option>
                                <option>USDT</option>
                                <option>BNB Smart Chain (BEP-20)</option>
                                <option>Other</option>

                            </select>

                        </div>


                        <!-- Existing Wallet -->

                        <div>

                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Do you already have an existing wallet?
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">

                                @foreach (var option in new[] { "Yes", "No" })
                                {
                                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4">

                                        <input asp-for="HasExistingWallet"
                                               type="radio"
                                               value="@option" />

                                        <span>@option</span>

                                    </label>
                                }

                            </div>

                        </div>


                        <!-- Preferred Wallet -->

                        <div>

                            <label asp-for="PreferredWalletType"
                                   class="mb-2 block text-sm font-semibold text-amber-950">

                                What is your preferred wallet type?

                            </label>

                            <select asp-for="PreferredWalletType"
                                    class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3">

                                <option value="">Select wallet type</option>
                                <option>Mobile wallet</option>
                                <option>Desktop wallet</option>
                                <option>Hardware wallet</option>
                                <option>Exchange wallet</option>

                            </select>

                        </div>


                        <!-- Backup -->

                        <div>

                            <label asp-for="WalletRecoveryBackedUp"
                                   class="mb-2 block text-sm font-semibold text-amber-950">

                                Have you securely backed up your wallet recovery information?

                            </label>

                            <select asp-for="WalletRecoveryBackedUp"
                                    class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3">

                                <option value="">Select answer</option>
                                <option>Yes</option>
                                <option>No</option>
                                <option>Not applicable</option>

                            </select>

                        </div>


                        <!-- Transaction Frequency -->

                        <div>

                            <label asp-for="ExpectedTransactionFrequency"
                                   class="mb-2 block text-sm font-semibold text-amber-950">

                                What is your expected transaction frequency?

                            </label>

                            <select asp-for="ExpectedTransactionFrequency"
                                    class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3">

                                <option value="">Select frequency</option>
                                <option>Occasionally</option>
                                <option>Weekly</option>
                                <option>Several times a week</option>
                                <option>Daily</option>

                            </select>

                        </div>

                    </div>

                </div>


                <div class="mt-6 flex items-center justify-between">

                    <button type="button"
                            class="previous-button rounded-lg border border-amber-300 bg-amber-50 px-6 py-3 text-sm font-semibold text-amber-900">

                        Previous

                    </button>

                    <button type="button"
                            class="next-button rounded-lg bg-amber-900 px-6 py-3 text-sm font-semibold text-amber-50">

                        Next: Financial Flow

                    </button>

                </div>

            </section>

            <!-- ================================================= -->
            <!-- SECTION 7 -->
            <!-- ================================================= -->

            <section class="form-section hidden"
                     data-section="6"
                     id="financial-flow-section">

                <div class="rounded-2xl border border-amber-200 bg-amber-50 shadow-sm">

                    <div class="border-b border-amber-200 px-6 py-6 sm:px-8">

                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">
                            Section 7
                        </p>

                        <h2 class="mt-2 text-2xl font-bold text-amber-950">
                            Financial & Asset Flow Analysis
                        </h2>

                    </div>

                    <div class="space-y-6 p-6 sm:p-8">

                        <div>
                            <label asp-for="InitialTransactionAmount">What was the initial amount involved in the reported transaction?</label>

                            <textarea asp-for="InitialTransactionAmount"
                                      rows="3"
                                      class="w-full rounded-lg border border-amber-200 p-4"></textarea>
                        </div>

                        <div>
                            <label asp-for="SubsequentFundMovements">
                                What subsequent movements of funds were identified?
                            </label>

                            <textarea asp-for="SubsequentFundMovements"
                                      rows="4"
                                      class="w-full rounded-lg border border-amber-200 p-4"></textarea>
                        </div>

                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Were funds divided into multiple transactions or transferred to multiple addresses?
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">
                                @foreach (var option in new[] { "Yes", "No" })
                                {
                                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4">
                                        <input asp-for="FundsDividedOrMultipleAddresses"
                                               type="radio"
                                               value="@option" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Were funds subsequently consolidated into another wallet?
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">
                                @foreach (var option in new[] { "Yes", "No" })
                                {
                                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4">
                                        <input asp-for="FundsConsolidatedIntoAnotherWallet"
                                               type="radio"
                                               value="@option" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Were there transaction fees, exchange conversions, or other deductions?
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">
                                @foreach (var option in new[] { "Yes", "No" })
                                {
                                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4">
                                        <input asp-for="TransactionFeesOrConversions"
                                               type="radio"
                                               value="@option" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Does the movement of funds correspond with the financial account provided by the complainant?
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">
                                @foreach (var option in new[] { "Yes", "No" })
                                {
                                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4">
                                        <input asp-for="FundsCorrespondWithComplainantAccount"
                                               type="radio"
                                               value="@option" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Were any addresses associated with known exchanges or service providers?
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">
                                @foreach (var option in new[] { "Yes", "No" })
                                {
                                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4">
                                        <input asp-for="AddressesLinkedToExchanges"
                                               type="radio"
                                               value="@option" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div>
                            <p class="mb-3 text-sm font-semibold text-amber-950">
                                Were newly created or previously unidentified addresses encountered during the investigation?
                            </p>

                            <div class="grid gap-3 sm:grid-cols-2">
                                @foreach (var option in new[] { "Yes", "No" })
                                {
                                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-amber-200 bg-white p-4">
                                        <input asp-for="NewOrUnknownAddressesEncountered"
                                               type="radio"
                                               value="@option" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div>
                            <label asp-for="WalletCompanyName"
                                   class="mb-2 block text-sm font-semibold text-amber-950">
                                Wallet company name
                            </label>

                            <select asp-for="WalletCompanyName"
                                    asp-items="Html.GetEnumSelectList<Round_OP.Models.Enums.WalletCompanyName>()"
                                    class="w-full rounded-lg border border-amber-200 bg-white px-4 py-3">

                                <option value="">Select wallet company</option>

                            </select>
                        </div>

                    </div>

                </div>

                <div class="mt-6 flex items-center justify-between">

                    <button type="button" class="previous-button">
                        Previous
                    </button>

                    <button type="button" class="next-button rounded-lg bg-amber-900 px-6 py-3 text-sm font-semibold text-amber-50 transition hover:bg-amber-800">
                        Next: Court Proceedings
                    </button>

                </div>

            </section>

            <!-- ================================================= -->
            <!-- SECTION 8 -->
            <!-- ================================================= -->

            <section class="form-section hidden"
                     data-section="7"
                     id="wallet-relationship-section">

                <div class="rounded-2xl border border-amber-200 bg-amber-50 shadow-sm">

                    <div class="border-b border-amber-200 px-6 py-6 sm:px-8">

                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">
                            Section 8
                        </p>

                        <h2 class="mt-2 text-2xl font-bold text-amber-950">
                            Court Proceedings
                        </h2>

                    </div>

                    <div class="space-y-6 p-6 sm:p-8">

                        <div class="space-y-6 p-6 sm:p-8">

                            <h1>No Questions yet</h1>

                        </div>

                    </div>

                </div>


                <div class="mt-6 flex items-center justify-between">

                    <button type="button"
                            class="previous-button rounded-lg border border-amber-300 bg-amber-50 px-6 py-3">

                        Previous

                    </button>

                    <!-- FINAL SUBMIT -->

                    <button type="submit"
                            class="next-button rounded-lg bg-amber-900 px-6 py-3 text-sm font-semibold text-amber-50 transition hover:bg-amber-800">

                        Submit Investigation Report

                    </button>

                </div>

            </section>

            <div id="formToast"
                 class="pointer-events-none fixed right-5 top-5 z-[9999] hidden max-w-sm rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-medium text-red-800 shadow-lg transition-all duration-300">
                <span id="formToastMessage"></span>
            </div>
        </form>

    </div>
</div>

<style>
    .section-nav {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 0.9rem;
        border-radius: 0.75rem;
        font-size: 0.875rem;
        font-weight: 600;
        white-space: nowrap;

        background: rgb(120 53 15);
        color: rgb(255 251 235);

        cursor: pointer;
        transition: all 150ms ease;
    }

    .section-nav:hover:not(.locked) {
        background: rgb(146 64 14);
    }

    .section-nav.active {
        background: rgb(120 53 15);
        color: rgb(255 251 235);
        box-shadow: 0 0 0 2px rgb(245 158 11);
    }

    .section-nav.locked {
        background: rgb(254 243 199);
        color: rgb(120 53 15);
        cursor: not-allowed;
        opacity: 0.45;
    }

    .step-indicator {
        display: inline-flex;
        height: 1.5rem;
        width: 1.5rem;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        background: rgb(255 251 235);
        color: rgb(120 53 15);
        font-size: 0.75rem;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const sections = Array.from(
                document.querySelectorAll(".form-section")
            );

            const navItems = Array.from(
                document.querySelectorAll(".section-nav")
            );

            const form = document.getElementById("investigationForm");

            const stepNumber = document.getElementById("stepNumber");
            const stepTitle = document.getElementById("stepTitle");
            const progressPercent = document.getElementById("progressPercent");
            const progressBar = document.getElementById("progressBar");

            const stepTitles = [
                "Investigator Information",
                "Case Information",
                "Investigation Actions",
                "Blockchain Investigation",
                "Findings & Final Submission",
                "Wallet Registration Questions",
                "Financial & Asset Flow Analysis",
                "Wallet Relationship Analysis"
            ];

            let currentStep = 0;
            let highestUnlockedStep = 0;

            function updateProgress() {
                const progress =
                    ((currentStep + 1) / sections.length) * 100;

                stepNumber.textContent =
                    `Step ${currentStep + 1} of ${sections.length}`;

                stepTitle.textContent =
                    stepTitles[currentStep];

                progressPercent.textContent =
                    `${progress}%`;

                progressBar.style.width =
                    `${progress}%`;
            }
            function showFormToast(message) {
                const toast = document.getElementById("formToast");
                const messageElement = document.getElementById("formToastMessage");

                if (!toast || !messageElement) {
                    return;
                }

                messageElement.textContent = message;

                toast.classList.remove("hidden");

                setTimeout(() => {
                    toast.classList.add("hidden");
                }, 3000);
            }
            function showSectionMessage(message) {
                let banner = document.getElementById("sectionValidationMessage");

                if (!banner) {
                    banner = document.createElement("div");
                    banner.id = "sectionValidationMessage";
                    banner.className = "mb-4 hidden rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900";
                    const formBody = form.querySelector(".form-section") || form;
                    formBody.parentNode.insertBefore(banner, formBody);
                }

                banner.textContent = message;
                banner.classList.remove("hidden");
            }

            function hideSectionMessage() {
                const banner = document.getElementById("sectionValidationMessage");
                if (banner) {
                    banner.classList.add("hidden");
                }
            }

            function showStep(step) {
                if (
                    step < 0 ||
                    step >= sections.length ||
                    step > highestUnlockedStep
                ) {
                    return;
                }

                hideSectionMessage();

                sections.forEach((section, index) => {
                    section.classList.toggle(
                        "hidden",
                        index !== step
                    );
                });

                navItems.forEach((item, index) => {

                    // Reset the navigation item completely
                    item.classList.remove(
                        "active",
                        "locked"
                    );

                    // Anything beyond the furthest unlocked step is locked
                    if (index > highestUnlockedStep) {
                        item.classList.add("locked");
                    }

                    // Current section
                    if (index === step) {
                        item.classList.add("active");
                    }
                });

                currentStep = step;

                updateProgress();
                updateNextButton();

                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });
            }

            function isFieldValid(field) {

                if (field.type === "radio") {
                    const group = document.querySelectorAll(
                        `input[type="radio"][name="${field.name}"]`
                    );

                    return Array.from(group).some(
                        radio => radio.checked
                    );
                }

                if (field.type === "checkbox") {
                    return !field.required || field.checked;
                }

                if (!field.checkValidity()) {
                    return false;
                }

                if (
                    (
                        field.tagName === "INPUT" &&
                        ["text", "email", "tel"].includes(field.type)
                    ) ||
                    field.tagName === "TEXTAREA"
                ) {
                    return field.value.trim() !== "";
                }

                return true;
            }

            function getRequiredFieldsForSection(section) {
                return Array.from(
                    section.querySelectorAll(
                        "input:not([type='hidden']), select, textarea"
                    )
                ).filter(field => {
                    if (field.disabled) {
                        return false;
                    }

                    if (field.type === "radio") {
                        return field.required;
                    }

                    return field.required;
                });
            }

            function validateCurrentSection() {
                const section = sections[currentStep];
                const fields = getRequiredFieldsForSection(section);

                let valid = true;
                const processedRadioGroups = new Set();

                fields.forEach(field => {
                    if (field.type === "radio") {
                        if (processedRadioGroups.has(field.name)) {
                            return;
                        }

                        processedRadioGroups.add(field.name);

                        const group = Array.from(
                            section.querySelectorAll(
                                `input[type="radio"][name="${field.name}"][required]`
                            )
                        );

                        const groupValid = group.some(radio => radio.checked);

                        group.forEach(radio => {
                            radio.classList.toggle("field-error", !groupValid);
                        });

                        if (!groupValid) {
                            valid = false;
                        }

                        return;
                    }

                    field.classList.remove("field-error");

                    if (!isFieldValid(field)) {
                        field.classList.add("field-error");
                        valid = false;
                    }
                });

                if (!valid) {
                    const firstInvalid = fields.find(field => {
                        if (field.type === "radio") {
                            return !Array.from(
                                section.querySelectorAll(
                                    `input[type="radio"][name="${field.name}"][required]`
                                )
                            ).some(radio => radio.checked);
                        }

                        return !isFieldValid(field);
                    });

                    if (firstInvalid) {
                        if (firstInvalid.type === "radio") {
                            const radioGroup = Array.from(
                                section.querySelectorAll(
                                    `input[type="radio"][name="${firstInvalid.name}"][required]`
                                )
                            );

                            radioGroup[0]?.scrollIntoView({
                                behavior: "smooth",
                                block: "center"
                            });
                            radioGroup[0]?.focus();
                        } else {
                            firstInvalid.scrollIntoView({
                                behavior: "smooth",
                                block: "center"
                            });

                            firstInvalid.focus();
                        }
                    }
                }

                return valid;
            }

            function updateNextButton() {
                const section = sections[currentStep];
                const nextButton = section.querySelector(".next-button");

                if (!nextButton) return;

                const fields = Array.from(
                    section.querySelectorAll(
                        "input[required], select[required], textarea[required]"
                    )
                );

                let valid = true;
                const processedRadioGroups = new Set();

                fields.forEach(field => {
                    if (field.type === "radio") {
                        if (processedRadioGroups.has(field.name)) {
                            return;
                        }

                        processedRadioGroups.add(field.name);

                        const group = section.querySelectorAll(
                            `input[type="radio"][name="${field.name}"]`
                        );

                        if (!Array.from(group).some(radio => radio.checked)) {
                            valid = false;
                        }

                        return;
                    }

                    if (!isFieldValid(field)) {
                        valid = false;
                    }
                });

                nextButton.disabled = !valid;
            }

            form.querySelectorAll("input, select, textarea").forEach(field => {
                field.addEventListener("input", updateNextButton);
                field.addEventListener("change", updateNextButton);
            });
            // Next buttons
            document.querySelectorAll(".next-button").forEach(button => {
                button.addEventListener("click", function () {

                    if (!validateCurrentSection()) {
                        showFormToast(
                            "Please complete all required fields before continuing."
                        );
                        return;
                    }

                    if (currentStep < sections.length - 1) {
                        highestUnlockedStep =
                            Math.max(
                                highestUnlockedStep,
                                currentStep + 1
                            );

                        showStep(currentStep + 1);
                    }
                });
            });

            // Previous buttons
            document.querySelectorAll(".previous-button").forEach(button => {

                button.addEventListener("click", function () {

                    if (currentStep > 0) {
                        showStep(currentStep - 1);
                    }
                });
            });

            // Section navigation
            navItems.forEach((item, index) => {

                item.addEventListener("click", function () {

                    if (index <= highestUnlockedStep) {
                        showStep(index);
                    }
                });
            });

            // Final submission
            form.addEventListener("submit", function (event) {

                // Validate the current section first
                if (!validateCurrentSection()) {
                    event.preventDefault();
                    return;
                }

                // Validate every section before allowing submission
                for (let i = 0; i < sections.length; i++) {

                    const fields = Array.from(
                        sections[i].querySelectorAll(
                            "input[required], select[required], textarea[required]"
                        )
                    );

                    const sectionIsValid =
                        fields.every(field => isFieldValid(field));

                    if (!sectionIsValid) {
                        event.preventDefault();

                        highestUnlockedStep = Math.max(
                            highestUnlockedStep,
                            i
                        );

                        showStep(i);

                        validateCurrentSection();

                        return;
                    }
                }

                // Server-side validation remains authoritative.
            });

            updateProgress();
            showStep(0);
            const attachmentInput = document.querySelector('input[name="Attachments"]');

            const selectedFiles = document.getElementById("selectedFiles");

            if (attachmentInput && selectedFiles) {
                attachmentInput.addEventListener("change", function () {
                    selectedFiles.innerHTML = "";

                    Array.from(this.files).forEach(file => {
                        const item = document.createElement("div");

                        item.className =
                            "flex items-center justify-between rounded-lg border border-amber-200 bg-white px-4 py-3 text-sm";

                        item.innerHTML = `
                                                                                                                                                        <div class="min-w-0">
                                                                                                                                                            <p class="truncate font-medium text-amber-950">
                                                                                                                                                                ${escapeHtml(file.name)}
                                                                                                                                                            </p>
                                                                                                                                                            <p class="mt-1 text-xs text-amber-950/50">
                                                                                                                                                                ${formatFileSize(file.size)}
                                                                                                                                                            </p>
                                                                                                                                                        </div>
                                                                                                                                                    `;

                        selectedFiles.appendChild(item);
                    });
                });
            }

            function formatFileSize(bytes) {
                if (bytes < 1024) {
                    return `${bytes} B`;
                }

                if (bytes < 1024 * 1024) {
                    return `${(bytes / 1024).toFixed(1)} KB`;
                }

                return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
            }

            function escapeHtml(value) {
                const div = document.createElement("div");
                div.textContent = value;
                return div.innerHTML;
            }
        });
        document.addEventListener("DOMContentLoaded", function () {

            const invalidFieldName = '@ViewData["ScrollTo"]';

            if (!invalidFieldName) {
                return;
            }

            const field = document.querySelector(
                `[name="${invalidFieldName}"]`
            );

            if (!field) {
                return;
            }

            const section = field.closest(".form-section");

            if (!section) {
                field.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });

                return;
            }

            setTimeout(() => {
                section.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

                const focusable = section.querySelector(
                    "input, select, textarea"
                );

                if (focusable) {
                    setTimeout(() => {
                        focusable.focus({ preventScroll: true });
                    }, 400);
                }
            }, 100);
        });
    </script>
}